# ─────────────────────────────────────────────
#  STEM Commons — single monorepo .env template
#  Copy to .env and fill in real values:  cp .env.example .env
#  Consumed by docker-compose, the FastAPI backend, and Vite.
#  (.env is gitignored — never commit real secrets.)
# ─────────────────────────────────────────────

# ── Backend / API ─────────────────────────────
# Local (non-Docker) DB connection. In Docker this is built from the
# POSTGRES_* values below against the "postgres" service host.
DATABASE_URL=postgresql://user:password@localhost:5432/stem_commons
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ENVIRONMENT=development

# ── Auth / security ───────────────────────────
# JWT signing key. Generate a strong one for production:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_dev_only_insecure_secret_key_override_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Bootstrap admin (created on first startup if no admin exists)
FIRST_ADMIN_EMAIL=admin@stemcommons.in
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=ChangeMe123!

# ── Postgres (docker-compose) ─────────────────
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=stem_commons

# ── Frontend (Vite) — only VITE_* reach the browser ──
VITE_API_URL=http://localhost:8000/api/v1
